# Netatmo developer app credentials (https://dev.netatmo.com/apps).
# Optional: `netatmo-energy-mcp login` asks for them and stores them in your
# user configuration directory. When set, these variables take precedence.
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=

# Must match the redirect URI registered in your Netatmo app.
# NETATMO_REDIRECT_URI=http://localhost:8977/callback

# NETATMO_MCP_CONFIG_DIR=
# NETATMO_MCP_LOG_LEVEL=info
