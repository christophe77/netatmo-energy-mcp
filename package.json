{
  "name": "netatmo-energy-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only MCP server for Netatmo smart thermostats and radiator valves: heating status, history and analytics for AI assistants.",
  "keywords": [
    "netatmo",
    "netatmo-energy",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "thermostat",
    "radiator-valves",
    "smart-home",
    "home-automation",
    "heating",
    "claude"
  ],
  "homepage": "https://github.com/christophe77/netatmo-energy-mcp#readme",
  "bugs": {
    "url": "https://github.com/christophe77/netatmo-energy-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophe77/netatmo-energy-mcp.git"
  },
  "license": "Apache-2.0",
  "author": "christophe77",
  "mcpName": "io.github.christophe77/netatmo-energy-mcp",
  "type": "module",
  "bin": {
    "netatmo-energy-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.fr.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "check:package": "node scripts/check-package.mjs",
    "docs:tools": "node scripts/gen-tools-doc.mjs",
    "docs:check": "node scripts/gen-tools-doc.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
